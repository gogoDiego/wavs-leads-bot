# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_LEADS_CHANNEL_ID=C0123456789
SLACK_ADMIN_USER_ID=U0123456789

# Local dev only — set to 'true' and provide SLACK_APP_TOKEN to use Socket Mode
# instead of HTTP. Vercel production always uses HTTP (Socket Mode = false).
SLACK_SOCKET_MODE=true
SLACK_APP_TOKEN=xapp-...

# Postgres — Supabase or Vercel Postgres or any Postgres connection string
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Required only on Vercel — auth for the /api/worker cron endpoint
CRON_SECRET=

# Apify (Phase 2)
APIFY_TOKEN=apify_api_...
APIFY_TWEET_ACTOR=altimis/scweet

# Anthropic (Phase 2)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Misc
TZ=America/Chicago
LOG_LEVEL=info
